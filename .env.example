# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- General ---
TIMEZONE=America/New_York
PUID=1000
PGID=1000

# --- Lychee ---
# Port Lychee will be reachable on at http://localhost:<port>
LYCHEE_PORT=90
# Public URL for the site (your Cloudflare domain, once the tunnel is set up)
APP_URL=https://photos.yourdomain.com

# --- Database (MariaDB) ---
DB_DATABASE=lychee
DB_USERNAME=lychee
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# --- Cloudflare Tunnel ---
# Create a tunnel at https://one.dash.cloudflare.com -> Networks -> Tunnels
# and paste the token it gives you here.
CLOUDFLARE_TUNNEL_TOKEN=
